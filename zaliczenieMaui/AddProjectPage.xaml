<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zaliczenieMaui.AddProjectPage">
    

    <StackLayout Padding="10">
        <Entry x:Name="TitleEntry" Placeholder="Project Title" />
        <Editor x:Name="DescriptionEditor" Placeholder="Project Description" />
        <DatePicker x:Name="DeadlinePicker" />
        <Button Text="Add Project" Clicked="OnAddProjectClicked" />
    </StackLayout>
</ContentPage>
