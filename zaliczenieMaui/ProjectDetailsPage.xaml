<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zaliczenieMaui.ProjectDetailsPage"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollView>
        <StackLayout Padding="10">
            <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="Large" />
            <StackLayout>
                <Label Text="Project Details" FontAttributes="Bold" FontSize="Large" />
                <Label x:Name="OwnerLabel" />
                <Label x:Name="DescriptionLabel" />
                <Label x:Name="DeadlineLabel" />
                <Label x:Name="StatusLabel" />
                <Button Text="Edit" Clicked="OnEditProjectClicked" IsVisible="{Binding IsOwner}" />
            </StackLayout>
            <StackLayout IsVisible="{Binding IsOwner}">
                <Label Text="Members" FontAttributes="Bold" FontSize="Large" />
                <CollectionView x:Name="MembersCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout>
                                <Label Text="{Binding MemberEmail}" FontSize="Small" />
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="Add Member" Clicked="OnAddMemberClicked" />
            </StackLayout>
            <Label Text="Tasks" FontAttributes="Bold" FontSize="Medium" />
            <CollectionView x:Name="TasksCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" />
                                <Label Text="{Binding IsCompleted, StringFormat='Completed: {0}'}" />
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaskTapped" />
                                </Frame.GestureRecognizers>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Add Task" Clicked="OnAddTaskClicked" IsVisible="{Binding IsOwner}" />
            <Label Text="Comments" FontAttributes="Bold" FontSize="Medium" />
            <CollectionView x:Name="CommentsCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding AuthorEmail}" FontAttributes="Bold" />
                                <Label Text="{Binding Text}" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Entry x:Name="CommentEntry" Placeholder="Write a comment..." Style="{StaticResource EntryStandardStyle}"/>
            <Button Text="Send" Clicked="OnSendCommentClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>